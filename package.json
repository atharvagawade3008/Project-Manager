{
  "name": "project-os",
  "version": "1.0.0",
  "description": "Project OS — Personal AI Project Planner & Autonomous Progress Intelligence System",
  "private": true,
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run dev:server\" \"npm run dev:client\"",
    "build": "npm --prefix server run build && npm --prefix client run build",
    "prisma:generate": "npm --prefix server run prisma:generate",
    "prisma:migrate": "npm --prefix server run prisma:migrate",
    "prisma:studio": "npm --prefix server run prisma:studio"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
