datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Project {
  id                   String            @id @default(uuid())
  name                 String
  description          String
  category             String            @default("Software Development")
  objective            String            @default("")
  expectedDeliverables String            @default("")
  techStack            String            @default("[]") // JSON string array
  startDate            DateTime?
  targetDeadline       DateTime?
  complexity           String            @default("Medium") // Low, Medium, High, Very High
  status               String            @default("ACTIVE") // PLANNING, ACTIVE, PAUSED, COMPLETED, ARCHIVED
  healthStatus         String            @default("GOOD") // EXCELLENT, GOOD, NEEDS_ATTENTION, CRITICAL
  rootPath             String?
  activeModel          String?
  projectType          String?           // Classification code (BUSINESS_WEBSITE, GAME_3D, ...)
  projectTypeSource    String            @default("AUTO") // AUTO | USER
  projectTypeConfidence Float?
  scopeApprovedAt      DateTime?
  dimensionWeightOverrides String        @default("{}") // JSON map of dimension key -> weight
  overallProgress      Float             @default(0.0)
  verificationConfidence Float           @default(0.0)
  lastScanAt           DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  phases               ProjectPhase[]
  modules              ProjectModule[]
  milestones           Milestone[]
  tasks                Task[]
  features             Feature[]
  scannedFiles         ScannedFile[]
  analysisJobs         AnalysisJob[]
  analysisReports      AnalysisReport[]
  progressSnapshots    ProgressSnapshot[]
  assessments          ProjectAssessment[]
  recommendations      AIRecommendation[]
  conversations        AIConversation[]
  activities           ProjectActivity[]
}

model ProjectPhase {
  id          String          @id @default(uuid())
  projectId   String
  name        String
  description String          @default("")
  orderIndex  Int             @default(0)
  startDate   DateTime?
  endDate     DateTime?
  status      String          @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, COMPLETED

  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  modules     ProjectModule[]
  tasks       Task[]
}

model ProjectModule {
  id          String       @id @default(uuid())
  projectId   String
  phaseId     String?
  name        String
  description String       @default("")
  orderIndex  Int          @default(0)

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase       ProjectPhase? @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  milestones  Milestone[]
  tasks       Task[]
}

model Milestone {
  id          String        @id @default(uuid())
  projectId   String
  moduleId    String?
  title       String
  description String        @default("")
  targetDate  DateTime?
  isCompleted Boolean       @default(false)
  completedAt DateTime?

  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  module      ProjectModule? @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  tasks       Task[]
}

model Task {
  id                 String          @id @default(uuid())
  projectId          String
  phaseId            String?
  moduleId           String?
  milestoneId        String?
  title              String
  description        String          @default("")
  status             String          @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, BLOCKED, IN_REVIEW, COMPLETED
  priority           String          @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  estimatedHours     Float?
  actualHours        Float?
  deadline           DateTime?
  completionCriteria String?
  technicalNotes     String?
  aiRecommendations  String?
  orderIndex         Int             @default(0)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  project            Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase              ProjectPhase?   @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  module             ProjectModule?  @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  milestone          Milestone?      @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  subtasks           Subtask[]
  dependencies       TaskDependency[] @relation("TaskDependencies")
  dependentOn        TaskDependency[] @relation("TaskDependentOn")
}

model TaskDependency {
  id               String @id @default(uuid())
  taskId           String
  dependsOnTaskId  String
  dependencyType   String @default("FINISH_TO_START")

  task             Task   @relation("TaskDependencies", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTask    Task   @relation("TaskDependentOn", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)
}

model Subtask {
  id          String   @id @default(uuid())
  taskId      String
  title       String
  isCompleted Boolean  @default(false)
  orderIndex  Int      @default(0)

  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Feature {
  id                     String            @id @default(uuid())
  projectId              String
  name                   String
  description            String            @default("")
  category               String            @default("Core")
  dimension              String            @default("functional") // Evaluation dimension key
  source                 String            @default("AI_DISCOVERED") // ORIGINAL_PLANNED | AI_DISCOVERED | AI_INFERRED_MISSING | USER_CONFIRMED
  expectedFunctionality  String            @default("") // What the feature is expected to do
  weight                 Float             @default(10.0) // Importance weight (e.g. 10, 20, 30)
  estimatedProgress      Float             @default(0.0)  // 0 - 100
  verificationConfidence Float             @default(0.0)  // 0 - 100
  status                 String            @default("MISSING") // IMPLEMENTED, PARTIALLY_IMPLEMENTED, PLACEHOLDER, MISSING, CANNOT_VERIFY, NOT_APPLICABLE
  verificationStatus     String            @default("UNVERIFIED") // VERIFIED, PARTIALLY_VERIFIED, UNVERIFIED, CANNOT_VERIFY, NOT_APPLICABLE
  included               Boolean           @default(true) // Include in scope / scoring
  userModified           Boolean           @default(false)
  missingRequirements    String?
  lastAssessedAt         DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  project                Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  evidences              FeatureEvidence[]
}

model FeatureEvidence {
  id                  String   @id @default(uuid())
  featureId           String
  filePath            String
  symbolOrComponent   String?
  evidenceDescription String
  status              String   @default("FOUND") // FOUND, PARTIAL, MISSING, BROKEN
  confidence          Float    @default(80.0)
  lineStart           Int?
  lineEnd             Int?
  createdAt           DateTime @default(now())

  feature             Feature  @relation(fields: [featureId], references: [id], onDelete: Cascade)
}

model ScannedFile {
  id           String    @id @default(uuid())
  projectId    String
  relativePath String
  extension    String
  sizeBytes    Int
  hash         String
  lastModified DateTime
  language     String
  fileCategory String    @default("SOURCE") // SOURCE, CONFIG, DOCS, TEST, BUILD, ASSET
  isExcluded   Boolean   @default(false)
  astSummary   String?
  updatedAt    DateTime  @updatedAt

  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, relativePath])
}

model AnalysisJob {
  id                String    @id @default(uuid())
  projectId         String
  status            String    @default("PENDING") // PENDING, RUNNING, COMPLETED, FAILED, CANCELLED
  currentStage      String?
  progressPercent   Float     @default(0.0)
  scannedFilesCount Int       @default(0)
  totalFilesCount   Int       @default(0)
  error             String?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime  @default(now())

  project           Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  report            AnalysisReport?
}

model AnalysisReport {
  id                  String      @id @default(uuid())
  jobId               String      @unique
  projectId           String
  architectureSummary String
  techStackDetected   String      @default("[]") // JSON
  frontendStructure   String?
  backendStructure    String?
  databaseStructure   String?
  apiRoutesSummary    String?
  componentsSummary   String?
  blockersDetected    String?     // JSON
  technicalDebt       String?     // JSON
  rawModelOutput      String?
  createdAt           DateTime    @default(now())

  job                 AnalysisJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  project             Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProgressSnapshot {
  id                     String   @id @default(uuid())
  projectId              String
  overallProgress        Float
  verificationConfidence Float
  totalFeatures          Int
  completedFeatures      Int
  scanJobId              String?
  frameworkVersion       String   @default("V1") // Legacy snapshots are V1; new assessments write V2
  productCompletion      Float?
  technicalCompletion    Float?
  productionReadiness    Float?
  assessmentId           String?
  summary                String?
  createdAt              DateTime @default(now())

  project                Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectAssessment {
  id                      String   @id @default(uuid())
  projectId               String
  scanJobId               String?
  frameworkVersion        String   @default("V2")
  projectType             String
  projectTypeLabel        String
  projectTypeSource       String   @default("AUTO")
  classificationConfidence Float   @default(0.0)
  productCompletion       Float?
  technicalCompletion     Float?
  productionReadiness     Float?
  evaluationConfidence    Float    @default(0.0)
  overallProgress         Float    @default(0.0) // Compatibility mirror of Product Completion
  scopeApproved           Boolean  @default(false)
  aiAssisted              Boolean  @default(false)
  dimensionsJson          String   @default("[]")
  featuresJson            String   @default("[]")
  scopeJson               String   @default("[]")
  nextActionsJson         String   @default("[]")
  classificationJson      String   @default("{}") // Project classification rationale and evidence
  websiteJson             String?  // Website-specific analysis snapshot
  summary                 String?
  notes                   String   @default("") // JSON array of methodology notes
  createdAt               DateTime @default(now())

  project                 Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model AIRecommendation {
  id                String   @id @default(uuid())
  projectId         String
  title             String
  explanation       String
  recommendedAction String
  priority          String   @default("HIGH") // LOW, MEDIUM, HIGH, CRITICAL
  category          String   @default("NEXT_STEP") // NEXT_STEP, ARCHITECTURE, REFACTOR, TEST, SECURITY
  relatedFeatureId  String?
  isConvertedToTask Boolean  @default(false)
  convertedTaskId   String?
  createdAt         DateTime @default(now())

  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model AIConversation {
  id         String   @id @default(uuid())
  projectId  String
  role       String   // USER, ASSISTANT, SYSTEM
  content    String
  citedFiles String?  // JSON array of file paths
  createdAt  DateTime @default(now())

  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectActivity {
  id          String   @id @default(uuid())
  projectId   String
  type        String   // PROJECT_CREATED, SCAN_COMPLETED, TASK_UPDATED, RECOMMENDATION_GENERATED, PLAN_UPDATED
  description String
  metadata    String?  // JSON
  createdAt   DateTime @default(now())

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model SystemSetting {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}
